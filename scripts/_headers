# Cloudflare Workers static-asset headers. Copied into public/ by the custom
# build step in wrangler.jsonc (Quartz wipes public/ on every build).
# Without this, every file was served with max-age=0, must-revalidate: each
# page view re-asked Cloudflare about ~40 css/js/font files.

# file names with a content hash: never change -> cache for a year
/component-*
  Cache-Control: public, max-age=31536000, immutable
/index-*
  Cache-Control: public, max-age=31536000, immutable
/static/resource-*
  Cache-Control: public, max-age=31536000, immutable
/static/scripts/*
  Cache-Control: public, max-age=31536000, immutable
/static/fonts/*
  Cache-Control: public, max-age=31536000, immutable
/static/katex/*
  Cache-Control: public, max-age=31536000, immutable

# unhashed but rarely changing: reuse for a while, refresh in the background
/static/contentIndex.json
  Cache-Control: public, max-age=600, stale-while-revalidate=86400
/static/site.js
  Cache-Control: public, max-age=3600, stale-while-revalidate=86400
/videos/*
  Cache-Control: public, max-age=86400, stale-while-revalidate=604800
/images/*
  Cache-Control: public, max-age=86400, stale-while-revalidate=604800
/tikz-svg/*
  Cache-Control: public, max-age=31536000, immutable
